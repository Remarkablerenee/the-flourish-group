#536346 0 18%,transparent 19%),linear-gradient(90deg,transparent 48%,#6f5739 49% 53%,transparent 54%);opacity:.9}.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding-top:24px;padding-bottom:90px}.pillar-card{background:#fff;border:1px solid var(--line);padding:32px;min-height:280px;box-shadow:0 10px 30px rgba(62,46,27,.05)}.icon{width:46px;height:46px;border:1px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--gold);font-size:20px}.pillar-card h2{font-family:var(--serif);font-size:34px;font-weight:500;margin:25px 0 8px}.pillar-card p{color:var(--muted);font-size:14px;max-width:360px}.pillar-card a,.feature-body a{color:var(--orange);text-transform:uppercase;font-size:11px;font-weight:700;letter-spacing:.08em}.statement{background:var(--charcoal);color:#f6f0e5}.statement-inner{min-height:480px;padding-top:90px;padding-bottom:90px;display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:60px}.eyebrow.light{color:#d4c7b5}.statement h2,.growth h2{font-family:var(--serif);font-weight:500;font-size:clamp(44px,5vw,72px);line-height:1.02;margin:25px 0}.statement-copy p{font-size:17px;color:#d3cec5}.btn-dark{border-color:#b89c68;color:#fff}.content-section{padding-top:95px;padding-bottom:95px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.section-heading h2{font-family:var(--serif);font-size:48px;font-weight:500;margin:14px 0 0}.section-heading>a{font-size:11px;text-transform:uppercase;color:var(--orange);font-weight:700}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.feature-card{background:#fff;border:1px solid var(--line)}.feature-visual{height:180px;position:relative;overflow:hidden;display:flex;align-items:end;padding:20px;font-family:var(--serif);font-size:27px;letter-spacing:.04em}.visual-orange{background:linear-gradient(135deg,#c84e17,#f09b55 52%,#d9c6ad)}.visual-warm{background:linear-gradient(135deg,#e9dfcf,#cbbca7 60%,#8c7559)}.visual-gold{background:linear-gradient(135deg,#a9864c,#e7d2a7 55%,#6e5a40)}.feature-visual span{color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.25)}.feature-body{padding:25px}.feature-body small{color:#8b7b65;text-transform:uppercase;letter-spacing:.12em;font-size:10px}.feature-body h3{font-family:var(--serif);font-size:28px;font-weight:500;margin:7px 0}.feature-body p{color:var(--muted);font-size:13px;min-height:60px}.growth{background:linear-gradient(120deg,#d8c19a,#efe2cc);display:grid;grid-template-columns:1fr 1fr;gap:50px;padding-top:70px;padding-bottom:70px}.growth h2{margin-bottom:0}.growth p{max-width:480px}.btn-outline{border-color:#9f8354}.site-footer{background:#1d1d1d;color:#eee;display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:30px;padding:40px clamp(24px,5vw,76px);align-items:end}.footer-brand{display:flex;align-items:center;gap:12px;font-family:var(--serif);letter-spacing:.06em;font-size:13px}.footer-brand small{display:block;color:#c9a96d;font-family:var(--sans);font-size:8px;letter-spacing:.15em;margin-top:5px}.brand-mark.small{width:40px;height:40px}.footer-nav{display:flex;gap:18px;flex-wrap:wrap;font-size:11px;color:#c8c1b8}.footer-meta{display:flex;flex-direction:column;align-items:flex-end;gap:7px;font-size:10px;color:#a8a198}.footer-meta a:hover,.footer-nav a:hover{color:#fff}.menu-toggle span{display:block;width:22px;height:1px;background:#222;margin:5px}
@media(max-width:900px){.nav,.nav-cta{display:none}.menu-toggle{display:block}.site-header.menu-open .nav{display:flex;position:absolute;top:78px;left:0;right:0;background:var(--paper);padding:20px 24px;flex-direction:column;border-bottom:1px solid var(--line)}.hero{grid-template-columns:1fr}.hero-art{min-height:420px;order:-1}.hero-copy{padding-top:55px}.pillars,.feature-grid{grid-template-columns:1fr}.statement-inner,.growth{grid-template-columns:1fr;gap:10px}.section-heading{display:block}.section-heading>a{display:inline-block;margin-top:12px}.site-footer{grid-template-columns:1fr}.footer-meta{align-items:flex-start}}
